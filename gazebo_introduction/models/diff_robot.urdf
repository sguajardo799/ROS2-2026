<?xml version="1.0"?>
<robot name="diff_robot">
	<link name="base_link">
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			<geometry>
				<box size="0.4 0.3 0.1"/>
			</geometry>
			<material name="amarillo">
				<color rgba="0.7 0.7 0.1 1.0"/>
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			<geometry>
				<box size="0.4 0.3 0.1"/>
			</geometry>
		</collision>
		<!-- Caja: ixx = m/12 (y^2 + z^2), iyy = m/12 (x^2 + z^2), izz = m/12 (x^2 + y^2) -->
		<inertial>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			<mass value="2.0"/>
			<inertia ixx="0.016667" ixy="0.0" ixz="0.0" iyy="0.028333" iyz="0.0" izz="0.041667"/>
		</inertial>
	</link>

	<link name="rueda_izquierda">
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
			<geometry>
				<cylinder radius="0.1" length="0.05"/>
			</geometry>
			<material name="negro">
				<color rgba="0.1 0.1 0.1 1.0"/>
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
			<geometry>
				<cylinder radius="0.1" length="0.05"/>
			</geometry>
		</collision>
		<!-- Cilindro: ixx = iyy = m/12 (3r^2 + h^2), izz = m r^2 / 2 -->
		<inertial>
			<origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
			<mass value="0.5"/>
			<inertia ixx="0.001354" ixy="0.0" ixz="0.0" iyy="0.001354" iyz="0.0" izz="0.0025"/>
		</inertial>
	</link>

	<link name="rueda_derecha">
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
			<geometry>
				<cylinder radius="0.1" length="0.05"/>
			</geometry>
			<material name="negro">
				<color rgba="0.1 0.1 0.1 1.0"/>
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
			<geometry>
				<cylinder radius="0.1" length="0.05"/>
			</geometry>
		</collision>
		<inertial>
			<origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
			<mass value="0.5"/>
			<inertia ixx="0.001354" ixy="0.0" ixz="0.0" iyy="0.001354" iyz="0.0" izz="0.0025"/>
		</inertial>
	</link>

	<link name="rueda_loca">
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			<geometry>
				<sphere radius="0.05"/>
			</geometry>
			<material name="gris">
				<color rgba="0.5 0.5 0.5 1.0"/>
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			<geometry>
				<sphere radius="0.05"/>
			</geometry>
		</collision>
		<!-- Esfera: ixx = iyy = izz = 2/5 m r^2 -->
		<inertial>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			<mass value="0.2"/>
			<inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/>
		</inertial>
	</link>

	<joint name="joint_rueda_izquierda" type="continuous">
		<parent link="base_link"/>
		<child link="rueda_izquierda"/>
		<origin xyz="-0.1 0.175 0.0" rpy="0.0 0.0 0.0"/>
		<axis xyz="0.0 1.0 0.0"/>
	</joint>

	<joint name="joint_rueda_derecha" type="continuous">
		<parent link="base_link"/>
		<child link="rueda_derecha"/>
		<origin xyz="-0.1 -0.175 0.0" rpy="0.0 0.0 0.0"/>
		<axis xyz="0.0 1.0 0.0"/>
	</joint>

	<joint name="joint_rueda_loca" type="fixed">
		<parent link="base_link"/>
		<child link="rueda_loca"/>
		<origin xyz="0.15 0.0 -0.05" rpy="0.0 0.0 0.0"/>
	</joint>

	<!-- Rueda loca sin friccion -->
	<gazebo reference="rueda_loca">
		<mu1>0.0</mu1>
		<mu2>0.0</mu2>
	</gazebo>

	<!-- Plugins de Gazebo (Harmonic) -->
	<gazebo>
		<plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
			<left_joint>joint_rueda_izquierda</left_joint>
			<right_joint>joint_rueda_derecha</right_joint>
			<wheel_separation>0.35</wheel_separation>
			<wheel_radius>0.1</wheel_radius>
			<topic>/cmd_vel</topic>
			<odom_topic>/odom</odom_topic>
			<tf_topic>/tf</tf_topic>
			<frame_id>odom</frame_id>
			<child_frame_id>base_link</child_frame_id>
		</plugin>
		<plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
			<topic>/joint_states</topic>
		</plugin>
	</gazebo>
</robot>
